
{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/admin/login", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/blogs", "destination": "/index.html" },
    { "source": "/admin/blogs/new", "destination": "/index.html" },
    { "source": "/admin/blogs/:id/edit", "destination": "/index.html" }
  ]
}

